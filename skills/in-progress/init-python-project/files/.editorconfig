# https://editorconfig.org - honoured by VS Code through the EditorConfig extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120   # matches [tool.ruff] line-length

[*.{json,toml,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # two trailing spaces are a Markdown line break

[*.{bat,cmd,ps1}]
end_of_line = crlf
